# Modelo de configuração do Marimbondos Informes RU.
# Copie este arquivo para ".env" e preencha com os seus dados.
# O ".env" fica só no seu computador (está no .gitignore) e guarda a senha
# de app do Gmail usada para enviar as notificações.

# E-mail/login do Gmail que ENVIA as notificações (remetente).
BUSCA_SMTP_USER=seu-email@gmail.com

# Senha de APP do Gmail (16 letras), gerada em
# https://myaccount.google.com/apppasswords  — NÃO é a senha normal da conta.
BUSCA_SMTP_PASSWORD=sua-senha-de-app

# (Opcional) servidor SMTP. Para Gmail, os padrões abaixo já funcionam.
BUSCA_SMTP_HOST=smtp.gmail.com
BUSCA_SMTP_PORT=587

# (Opcional) endereço no cabeçalho "De". Se vazio, usa o BUSCA_SMTP_USER.
BUSCA_SMTP_FROM=
